FRONTEND_ORIGIN=http://localhost:5173

# Phase 3 default is SQLite so schema and migrations can be developed without credentials.
# Leave empty to build a MySQL URL from the MYSQL_* fields below.
# For local SQLite development, use: sqlite:///./data/runtime/meetingmind.db
MEETINGMIND_DATABASE_URL=
# Optional path relative to the project root for shared Docker MySQL/Redis settings.
MEETINGMIND_INFRA_ENV_FILE=

# MySQL 8 configuration for the next step; do not commit the real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=meetingmind
MYSQL_USER=meetingmind
MYSQL_PASSWORD=

MEETINGMIND_DATA_DIR=data
MAX_UPLOAD_SIZE_MB=200
MAX_AUDIO_DURATION_MINUTES=60

MEETINGMIND_FFMPEG_BIN=
MEETINGMIND_WHISPER_MODEL=small
MEETINGMIND_WHISPER_LANGUAGE=zh
MEETINGMIND_DIARIZATION_ENABLED=true
MEETINGMIND_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=

# Phase 4 OpenAI Responses API. Keep the real key only in .env/meetingmind.env.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-terra
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_CHARS=120000


# Phase 6: Redis + RQ durable asynchronous processing.
# Normal runtime must use rq. `inline` is only for isolated automated tests.
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=meetingmind
RQ_JOB_TIMEOUT_SECONDS=7200
RQ_RESULT_TTL_SECONDS=86400
RQ_FAILURE_TTL_SECONDS=604800
# Mark an abandoned queue task failed after this many seconds, enabling retry.
RQ_STALE_JOB_SECONDS=300
RQ_RECONCILIATION_INTERVAL_SECONDS=30
MEETINGMIND_QUEUE_BACKEND=rq
LOG_LEVEL=INFO
